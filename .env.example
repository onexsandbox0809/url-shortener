# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: used to build the short URL in API responses.
# If not set, the app falls back to the request's host header.
# Set this to your production domain once you know it, e.g. https://links.yourbrand.com
NEXT_PUBLIC_BASE_URL=
